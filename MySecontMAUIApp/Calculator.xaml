<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MySecondMAUIApp.Calculator"
             Title="">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Column="0"
            Grid.Row="0"
            BackgroundColor="#eee">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>


            <Label x:Name="ActionView"
                   Text="null"
                   TextColor="#333"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="End"
                   FontSize="25"
                   FontAttributes="Bold"
                   Grid.Column="0"
                   Grid.Row="0"/>

            <Label x:Name="InputView"
                   Text="null"
                   TextColor="#333"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Start"
                   FontSize="35"
                   FontAttributes="Bold"
                   Grid.Column="0"
                   Grid.Row="1"
       />

        </Grid>
   
        <Grid x:Name="ButtonsPanel"
              Grid.Background="Grey"
              Grid.Column="0"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <Button Text="0" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2"  FontSize="35"/>
            <Button Text="1" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="3" FontSize="35"/>
            <Button Text="2" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="3" FontSize="35"/>
            <Button Text="3" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="3" FontSize="35"/>
            <Button Text="4" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="2" FontSize="35"/>
            <Button Text="5" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="2" FontSize="35"/>
            <Button Text="6" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="2" FontSize="35"/>
            <Button Text="7" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="1" FontSize="35"/>
            <Button Text="8" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="1" FontSize="35"/>
            <Button Text="9" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="1" FontSize="35"/>

            <Button Text="." Clicked="ButtonClicked" Grid.Column="2" Grid.Row="4" FontSize="35"/>
            <Button Text="=" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="3" Grid.RowSpan="2" FontSize="35"/>
            <Button Text="+" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="1" FontSize="35"/>
            <Button Text="-" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="2" FontSize="35"/>
            <Button Text="/" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="0" FontSize="35"/>
            <Button Text="*" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="0" FontSize="35"/>
            <Button Text="&lt;=" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="0" FontSize="35"/>
            <Button Text="C" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="0" FontSize="35"/>

        </Grid>

    </Grid>
    
</ContentPage>