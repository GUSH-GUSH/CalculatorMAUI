<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MySecondMAUIApp.Calculator"
             Title="">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="LightButton" TargetType="Button">
                <Setter Property="FontSize" Value="35"/>
                <Setter Property="FontAutoScalingEnabled" Value="True"/>
                <Setter Property="BackgroundColor" Value="#326dfa"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#212136"/>
            </Style>
            <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource LightButton}">
                <Setter Property="BackgroundColor" Value="#2D2DBA"/>
            </Style>
            <Style x:Key="Label" TargetType="Label">
                <Setter Property="FontSize" Value="25"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#f5f9ff"/>
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="Padding" Value="25, 0, 25, 0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Column="0"
            Grid.Row="0"
            BackgroundColor="#000e24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>


            <Label x:Name="ActionView"
                   Text="null"
                   Style="{StaticResource Label}"
                   VerticalTextAlignment="End"
                   Grid.Column="0"
                   Grid.Row="0"/>

            <Label x:Name="InputView"
                   Text="null"
                   Style="{StaticResource Label}"
                   VerticalTextAlignment="Start"
                   FontSize="35"
                   Grid.Column="0"
                   Grid.Row="1"/>

        </Grid>
   
        <Grid x:Name="ButtonsPanel"
              Grid.Background="#000e24"
              Grid.Column="0"
              Grid.Row="1"
              ColumnSpacing="5"
              RowSpacing="5"
              Padding="5">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>


            <Button Text="0" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2"  Style="{StaticResource LightButton}"/>
            <Button Text="1" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="3" Style="{StaticResource LightButton}"/>
            <Button Text="2" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="3" Style="{StaticResource LightButton}"/>
            <Button Text="3" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="3" Style="{StaticResource LightButton}"/>
            <Button Text="4" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="2" Style="{StaticResource LightButton}"/>
            <Button Text="5" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="2" Style="{StaticResource LightButton}"/>
            <Button Text="6" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="2" Style="{StaticResource LightButton}"/>
            <Button Text="7" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="1" Style="{StaticResource LightButton}"/>
            <Button Text="8" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="1" Style="{StaticResource LightButton}"/>
            <Button Text="9" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="1" Style="{StaticResource LightButton}"/>

            <Button Text="." Clicked="ButtonClicked" Grid.Column="2" Grid.Row="4" Style="{StaticResource LightButton}"/>
            <Button Text="=" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="3" Grid.RowSpan="2" Style="{StaticResource DarkButton}"/>
            <Button Text="+" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="1" Style="{StaticResource DarkButton}"/>
            <Button Text="-" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="2" Style="{StaticResource DarkButton}"/>
            <Button Text="/" Clicked="ButtonClicked" Grid.Column="2" Grid.Row="0" Style="{StaticResource DarkButton}"/>
            <Button Text="*" Clicked="ButtonClicked" Grid.Column="3" Grid.Row="0" Style="{StaticResource DarkButton}"/>
            <Button Text="&lt;=" Clicked="ButtonClicked" Grid.Column="1" Grid.Row="0" Style="{StaticResource DarkButton}"/>
            <Button Text="C" Clicked="ButtonClicked" Grid.Column="0" Grid.Row="0" Style="{StaticResource DarkButton}"/>

        </Grid>

    </Grid>
    
</ContentPage>